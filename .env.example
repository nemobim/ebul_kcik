# Firebase 웹 앱 설정 (Firebase 콘솔 → 프로젝트 설정 → 내 앱)
#
# 이 값들은 빌드 결과물에 포함되어 브라우저에 노출됩니다. 비밀키가 아니며,
# 실제 데이터 보호는 firestore.rules(Security Rules)가 담당합니다.
# 단, 실제 값이 담긴 .env 파일 자체는 커밋하지 마세요(.gitignore에 등록되어 있음).
VITE_API_KEY=
VITE_AUTH_DOMAIN=
VITE_PROJECT_ID=
VITE_STORAGE_BUCKET=
VITE_MESSAGING_SENDER_ID=
VITE_APP_ID=
# 현재 코드에서 사용하지 않음 (Analytics 미초기화). 비워 두어도 동작합니다.
VITE_MEASUREMENT_ID=
